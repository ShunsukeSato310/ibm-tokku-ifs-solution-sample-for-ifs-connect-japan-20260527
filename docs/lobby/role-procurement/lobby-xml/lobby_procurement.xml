  <DataSources>
    <!-- ds-jp-delay-status-005.xml -->
    <SQLDataSource>
      <Author>IBM Tokku Team</Author>
      <Component>PURCH</Component>
      <Keywords>調達,遅延,円グラフ</Keywords>
      <LastModified>2026-05-26-00.00.00</LastModified>
      <Locked>false</Locked>
      <Name>JP PO Delay Status Distribution</Name>
      <ID>ds-jp-delay-status-005</ID>
      <Select>
        <DataColumn><Column>DELAY_STATUS</Column><Name>DELAY_STATUS</Name><DataType>Text</DataType></DataColumn>
        <DataColumn><Column>ORDER_NO</Column><Name>ORDER_NO</Name><DataType>Text</DataType></DataColumn>
      </Select>
      <Where>OBJSTATE = &apos;Released&apos;</Where>
      <View>(SELECT CASE WHEN PLANNED_RECEIPT_DATE &lt; SYSDATE THEN &apos;遅延&apos; ELSE &apos;正常&apos; END AS DELAY_STATUS, ORDER_NO FROM PURCHASE_ORDER_LINE WHERE OBJSTATE = &apos;Released&apos;)</View>
    </SQLDataSource>
