    <Name>JP PO Header Count</Name>
    <ID>ds-jp-po-header-003</ID>
    <Select>
        <DataColumn>
            <Column>ORDER_NO</Column>
            <Name>発注番号</Name>
            <DataType>Text</DataType>
        </DataColumn>
    </Select>
    <Where>ORDER_NO IN (SELECT DISTINCT ORDER_NO FROM PURCHASE_ORDER_LINE WHERE OBJSTATE = 'Released')</Where>
    <View>PURCHASE_ORDER</View>
</SQLDataSource>
